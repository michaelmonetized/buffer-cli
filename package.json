{
  "name": "buffer-cli",
  "version": "0.1.0",
  "description": "A powerful CLI for scheduling social media posts through Buffer",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "buffer-cli": "dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "test": "bun test",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "buffer",
    "social-media",
    "cli",
    "twitter",
    "facebook",
    "linkedin",
    "instagram",
    "pinterest",
    "scheduler",
    "automation"
  ],
  "author": "Michael Hurley <michael@hurleyus.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelmonetized/buffer-cli.git"
  },
  "bugs": {
    "url": "https://github.com/michaelmonetized/buffer-cli/issues"
  },
  "homepage": "https://github.com/michaelmonetized/buffer-cli#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "inquirer": "^13.4.3",
    "open": "^11.0.0",
    "ora": "^9.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^25.7.0",
    "typescript": "^6.0.3"
  }
}
